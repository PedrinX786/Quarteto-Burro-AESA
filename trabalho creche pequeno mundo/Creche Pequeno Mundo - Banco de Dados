CREATE DATABASE creche_pequeno_mundo;
USE creche_pequeno_mundo;

CREATE TABLE endereco (
    id_endereco INT AUTO_INCREMENT PRIMARY KEY,
    rua VARCHAR(80),
    numero VARCHAR(10),
    bairro VARCHAR(50),
    cidade VARCHAR(50),
    estado CHAR(2)
);

CREATE TABLE turma (
    id_turma INT AUTO_INCREMENT PRIMARY KEY,
    nome_turma VARCHAR(50),
    faixa_etaria VARCHAR(20),
    capacidade INT,
    id_endereco INT,
    FOREIGN KEY(id_endereco) REFERENCES endereco(id_endereco)
);

CREATE TABLE professor (
    id_professor INT AUTO_INCREMENT PRIMARY KEY,
    nome_professor VARCHAR(60),
    formacao VARCHAR(80),
    salario DECIMAL(10,2),
    data_admissao DATE
);

CREATE TABLE sala (
    id_sala INT AUTO_INCREMENT PRIMARY KEY,
    numero_sala INT,
    id_turma INT UNIQUE,
    FOREIGN KEY(id_turma) REFERENCES turma(id_turma)
);

CREATE TABLE crianca (
    id_crianca INT AUTO_INCREMENT PRIMARY KEY,
    nome_crianca VARCHAR(60),
    data_nascimento DATE,
    id_turma INT,
    id_endereco INT,
    FOREIGN KEY(id_turma) REFERENCES turma(id_turma),
    FOREIGN KEY(id_endereco) REFERENCES endereco(id_endereco)
);

CREATE TABLE responsavel (
    id_responsavel INT AUTO_INCREMENT PRIMARY KEY,
    nome_responsavel VARCHAR(60),
    telefone VARCHAR(20),
    email VARCHAR(60)
);

CREATE TABLE crianca_responsavel (
    id_crianca INT,
    id_responsavel INT,
    parentesco VARCHAR(30),
    PRIMARY KEY(id_crianca, id_responsavel),
    FOREIGN KEY(id_crianca) REFERENCES crianca(id_crianca),
    FOREIGN KEY(id_responsavel) REFERENCES responsavel(id_responsavel)
);

CREATE TABLE frequencia (
    id_frequencia INT AUTO_INCREMENT PRIMARY KEY,
    id_crianca INT,
    data DATE,
    presenca CHAR(1),
    FOREIGN KEY(id_crianca) REFERENCES crianca(id_crianca)
);

CREATE TABLE atividade (
    id_atividade INT AUTO_INCREMENT PRIMARY KEY,
    nome_atividade VARCHAR(60),
    descricao VARCHAR(200),
    dia_semana VARCHAR(15),
    id_professor INT,
    FOREIGN KEY(id_professor) REFERENCES professor(id_professor)
);

CREATE TABLE crianca_atividade (
    id_crianca INT,
    id_atividade INT,
    PRIMARY KEY(id_crianca, id_atividade),
    FOREIGN KEY(id_crianca) REFERENCES crianca(id_crianca),
    FOREIGN KEY(id_atividade) REFERENCES atividade(id_atividade)
);

CREATE TABLE pagamento (
    id_pagamento INT AUTO_INCREMENT PRIMARY KEY,
    id_responsavel INT,
    data_pagamento DATE,
    valor DECIMAL(10,2),
    forma_pagamento VARCHAR(20),
    status_pagamento VARCHAR(20),
    FOREIGN KEY(id_responsavel) REFERENCES responsavel(id_responsavel)
);

CREATE TABLE funcionario (
    id_funcionario INT AUTO_INCREMENT PRIMARY KEY,
    nome_funcionario VARCHAR(60),
    cargo VARCHAR(40),
    salario DECIMAL(10,2),
    data_admissao DATE
);

CREATE TABLE alimentacao (
    id_alimentacao INT AUTO_INCREMENT PRIMARY KEY,
    id_funcionario INT,
    tipo_refeicao VARCHAR(30),
    cardapio VARCHAR(100),
    data_refeicao DATE,
    FOREIGN KEY(id_funcionario) REFERENCES funcionario(id_funcionario)
);

CREATE TABLE saude (
    id_crianca INT PRIMARY KEY,
    alergias VARCHAR(100),
    vacinado VARCHAR(3),
    plano_saude VARCHAR(60),
    FOREIGN KEY(id_crianca) REFERENCES crianca(id_crianca)
);

CREATE TABLE ocorrencia (
    id_ocorrencia INT AUTO_INCREMENT PRIMARY KEY,
    id_crianca INT,
    descricao VARCHAR(200),
    data_ocorrencia DATE,
    tipo_ocorrencia VARCHAR(40),
    FOREIGN KEY(id_crianca) REFERENCES crianca(id_crianca)
);

